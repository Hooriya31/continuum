# Copy to .env.local. Do not commit real keys.

# Public Supabase values are safe in the browser; row-level security
# must still be enabled so users only read/write their own rows.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only — never prefix these with NEXT_PUBLIC_
GEMINI_API_KEY=
